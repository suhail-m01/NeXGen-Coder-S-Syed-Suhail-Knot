# Explicit repository selection. Cloud failures never silently fall back to local data.
VITE_DATA_PROVIDER=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider secrets belong in Supabase Edge Function secret storage:
# RESEND_API_KEY, RESEND_FROM_EMAIL
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_APP_SECRET
# LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_WS_URL
# Never expose service-role or provider secrets through VITE_* variables.

# Hackathon Discovery UI (public browser flag).
NEXT_PUBLIC_ENABLE_HACKATHONS=true

# Hackathon Agent/API — SERVER ONLY. Never use a VITE_* or NEXT_PUBLIC_* prefix for these values.
DATABASE_URL=
CRON_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
KNOT_PUBLIC_URL=https://ne-x-gen-coder-s-syed-suhail-knot.vercel.app
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
HACKATHON_ENABLE_LLM_FALLBACK=false
SEARCH_API_PROVIDER=
SEARCH_API_KEY=
EVENTBRITE_API_KEY=
MEETUP_API_KEY=
# Enable only sources with reviewed ToS/robots permission. Permission evidence is required per source.
HACKATHON_ENABLED_SOURCES=
HACKATHON_SOURCE_CONFIG=[]
HACKATHON_HTTP_TIMEOUT_MS=12000
HACKATHON_HTTP_RETRIES=2
HACKATHON_DOMAIN_DELAY_MS=1500
HACKATHON_MAX_SOURCES=15
HACKATHON_MAX_QUERIES=72
HACKATHON_MAX_DOCUMENTS=24
HACKATHON_MAX_DETAIL_PAGES=12
HACKATHON_MAX_ITEMS=500
HACKATHON_MAX_RESPONSE_BYTES=2000000
HACKATHON_CONCURRENCY=3

# Optional production raster basemap. Attribution must remain accurate for the provider.
# Public OSM tiles are only a development/low-volume default, not an unlimited production SLA.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Server-only geocoder configuration for knot-geocode (never expose service secrets here).
# APP_ORIGINS is a comma-separated production browser-origin allowlist.
# Use an authorized Nominatim-compatible deployment; the public service is not a production SLA.
# APP_ORIGINS=https://your-app.example
# NOMINATIM_BASE_URL=https://your-authorized-nominatim.example/
# NOMINATIM_USER_AGENT=KnotEventDiscovery/1.0 (https://your-app.example)
# NOMINATIM_CONTACT_EMAIL=ops@your-app.example
